PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/skillbridge
JWT_SECRET=change-this-to-a-long-random-string
# Frontend URL (QR codes point here: <CLIENT_URL>/w/<token>)
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Production mein frontend/backend alag domain par ho to: COOKIE_SAMESITE=none (HTTPS zaroori)
COOKIE_SAMESITE=lax
